# Conexiones separadas con privilegios mínimos. Nunca usar el propietario en runtime.
DATABASE_URL=
DATABASE_WORKER_URL=
MIGRATIONS_DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Solo firma de archivos privados, nunca al navegador.
SUPABASE_STORAGE_KEY=
STORAGE_BUCKET=broquer-privado
SITIO_URL=https://your-site.example
ORIGENES_PERMITIDOS=["https://your-site.example"]
# Secretos aleatorios distintos de al menos 32 caracteres.
PROXY_SECRET=
RATE_LIMIT_SECRET=
# Array JSON de claves Fernet; primera cifra, todas descifran para permitir rotación.
SESIONES_CLAVES=[]
REGISTRO_HABILITADO=false
GOOGLE_HABILITADO=false
IA_MODELO_DEFAULT=claude-sonnet-4-6
ANTHROPIC_API_KEY=
